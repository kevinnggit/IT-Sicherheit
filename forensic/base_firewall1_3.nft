flush ruleset

table inet filter {
    set blocked_studs {
        type ipv4_addr
        
        elements = { 10.42.2.135, 10.42.2.131 }
    }

    chain input {
        type filter hook input priority 0; policy drop;

        ct state established,related accept

        iifname "lo" accept

        ip saddr @blocked_studs log prefix "BLOCKED_STUD: " counter drop

        # udp dport 31337 drop

        tcp dport 22 accept

        # tcp dport 80 accept
        tcp dport { 8000, 8001, 8002, 8003 } accept
        
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
